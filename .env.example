# ================================================================
# DIAPILE - Variables d'environnement
# Copiez ce fichier en .env et renseignez la cle du provider choisi.
#
# nrtg supporte TOUS les providers OpenAI-compatibles. Choisissez-en un :
#   --llm-provider <openrouter|openai|ollama>
#   --llm-model    <nom du modele>
#   --llm-api-base <URL>            (endpoint custom : vLLM, LM Studio, Groq, Together...)
#   --llm-api-key-env <ENV_VAR>     (nom de la variable contenant la cle)
#
# Le mode agent (--ai-agent) lit aussi NRTG_LLM_PROVIDER / NRTG_LLM_MODEL.
# ================================================================

# -- A) OpenRouter (gateway multi-modeles : OpenAI, Anthropic, Meta, NVIDIA, Mistral...) --
# Cle : https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# NRTG_LLM_PROVIDER=openrouter
# NRTG_LLM_MODEL=openai/gpt-4o-mini

# -- B) OpenAI --
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NRTG_LLM_PROVIDER=openai
# NRTG_LLM_MODEL=gpt-4o-mini

# -- C) Ollama local (100% gratuit, zero cle, zero exfiltration) --
#   ollama pull llama3
# NRTG_LLM_PROVIDER=ollama
# NRTG_LLM_MODEL=llama3
# OLLAMA_HOST=http://localhost:11434

# -- D) Endpoint OpenAI-compatible quelconque (vLLM, LM Studio, Groq, Together, DeepSeek...) --
# NRTG_LLM_PROVIDER=openai
# NRTG_LLM_MODEL=deepseek-chat
# GROQ_API_KEY=...
# (la cle est lue via --llm-api-key-env, ex. GROQ_API_KEY)

# -- Fallback (agent IA) : utilise si le provider principal echoue --
# NRTG_LLM_FALLBACK_PROVIDER=ollama

# -- Logging --
RUST_LOG=info
